{
  "name": "template-bun-cli",
  "version": "0.0.0",
  "bin": {
    "template": "./bin/run.js"
  },
  "scripts": {
    "build": "shx rm -rf dist && dotenvx run --env-file=.env.development -- tsc -b",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "bun run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "vitest run",
    "changeset": "changeset",
    "version": "changeset version && oclif readme && git add README.md",
    "release": "changeset publish",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "lint:dry": "biome lint",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "commitlint": "commitlint --edit",
    "preinstall": "npx only-allow bun",
    "prepare": "husky",
    "lint-staged": "bun exec lint-staged",
    "env:encrypt": "dotenvx encrypt -f .env.* -fk .env",
    "env:decrypt": "dotenvx decrypt -f .env.* -fk .env",
    "depscheck": "knip"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.66.0",
    "@oclif/core": "^4.11.3",
    "@oclif/plugin-help": "^6.2.49",
    "@oclif/plugin-plugins": "^5.4.68",
    "type-fest": "^5.6.0",
    "vitest": "^4.1.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@oclif/test": "^4.1.18",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.8.0",
    "@yoshintame/biome-config": "^1.0.0",
    "husky": "^9.1.7",
    "knip": "^6.14.1",
    "lint-staged": "^17.0.5",
    "oclif": "^4.23.7",
    "shx": "^0.4.0",
    "typescript": "^6.0.3"
  },
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json"
  ],
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "mynewcli",
    "dirname": "mynewcli",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " ",
    "topics": {
      "hello": {
        "description": "Say hello to the world and others"
      }
    }
  },
  "types": "dist/index.d.ts",
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "knip": {
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "entry": [
      "src/index.ts"
    ],
    "project": [
      "**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}"
    ]
  }
}
