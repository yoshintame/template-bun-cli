{
  "name": "template-bun-cli",
  "version": "0.0.0",
  "bin": {
    "template": "./bin/run.js"
  },
  "scripts": {
    "build": "shx rm -rf dist && dotenvx run --env-file=.env.development -- tsc -b",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "pnpm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "vitest run",
    "version": "oclif readme && git add README.md",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "lint:dry": "biome lint",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "commitlint": "commitlint --edit",
    "preinstall": "npx only-allow bun",
    "lint-staged": "bun exec lint-staged",
    "env:encrypt": "dotenvx encrypt -f .env.* -fk .env",
    "env:decrypt": "dotenvx decrypt -f .env.* -fk .env",
    "depscheck": "knip"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.48.4",
    "@oclif/core": "^4.5.2",
    "@oclif/plugin-help": "^6.2.32",
    "@oclif/plugin-plugins": "^5.4.46",
    "type-fest": "^4.41.0",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "@oclif/test": "^4.1.13",
    "@types/node": "^18.19.121",
    "oclif": "^4.22.6",
    "shx": "^0.3.4",
    "typescript": "^5.9.2",
    "@biomejs/biome": "^2.1.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.2.19",
    "husky": "^9.1.7",
    "knip": "^5.62.0",
    "lint-staged": "^16.1.4"
  },
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json"
  ],
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "mynewcli",
    "dirname": "mynewcli",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " ",
    "topics": {
      "hello": {
        "description": "Say hello to the world and others"
      }
    }
  },
  "types": "dist/index.d.ts",
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "knip": {
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "entry": [
      "src/index.ts"
    ],
    "project": [
      "**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}"
    ]
  }
}
